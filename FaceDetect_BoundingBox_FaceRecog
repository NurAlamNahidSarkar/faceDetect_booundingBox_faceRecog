 button_style='warning', layout=_layout)\nbtn_reset = widgets.Button(description='Reset all',  button_style='danger',  layout=_layout)\nbtn_done  = widgets.Button(description='Done ✓',     button_style='success', layout=_layout)\nstatus_lbl = widgets.Label(value='No points yet.')\ncode_lbl   = widgets.Textarea(value='zone_points = np.array([], dtype=np.int32)',\n                               layout=widgets.Layout(width='100%', height='80px'), disabled=True)\n\ndef refresh_code():\n    if not zone_points_list:\n        code_lbl.value = 'zone_points = np.array([], dtype=np.int32)'\n        return\n    lines = [f\"    [{p[0]}, {p[1]}],   # Corner {i+1}\" for i, p in enumerate(zone_points_list)]\n    code_lbl.value = \"zone_points = np.array([\\n\" + \"\\n\".join(lines) + \"\\n], dtype=np.int32)\"\n\ndef on_add(_):\n    zone_points_list.append((x_box.value, y_box.value))\n    status_lbl.value = f\"Added C{len(zone_points_list)}: ({x_box.value},{y_box.value})  | Total: {len(zone_points_list)}\"\n    refresh_code(); draw_canvas()\ndef on_undo(_):\n    if zone_points_list:\n        removed = zone_points_list.pop()\n        status_lbl.value = f\"Removed {removed}  |  {len(zone_points_list)} left\"\n        refresh_code(); draw_canvas()\ndef on_reset(_):\n    zone_points_list.clear()\n    status_lbl.value = 'Reset.'\n    refresh_code(); draw_canvas()\ndef on_done(_):\n    if len(zone_points_list) < 3:\n        status_lbl.value = '⚠ Need at least 3 points.'\n        return\n    global zone_points\n    zone_points = np.array(zone_points_list, dtype=np.int32)\n    zone_data = {'zone_points': zone_points.tolist(), 'frame_width': FRAME_W, 'frame_height': FRAME_H}\n    os.makedirs(DATA_FOLDER, exist_ok=True)\n    with open(ZONE_FILE, 'w') as f:\n        json.dump(zone_data, f, indent=4)\n    status_lbl.value = f\"✅ Done! {len(zone_points_list)} corners saved → {ZONE_FILE}\"\n    draw_canvas()\n    print(f\"\\n✅ PHASE 2 COMPLETE — zone saved to {ZONE_FILE}\")\n    print(f\"zone_points =\\n{zone_points}\")\n\nbtn_add.on_click(on_add); btn_undo.on_click(on_undo)\nbtn_reset.on_click(on_reset); btn_done.on_click(on_done)\ncontrols = widgets.HBox([x_box, y_box, btn_add, btn_undo, btn_reset, btn_done],\n                         layout=widgets.Layout(gap='8px', align_items='center'))\ndisplay(widgets.Label(value=f'Frame: {FRAME_W}×{FRAME_H}  |  Enter X, Y → Add point  |  Done ✓ saves zone'),\n        controls, status_lbl, img_widget,\n        widgets.Label(value='Live code output:'), code_lbl)\ndraw_canvas()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T07:22:58.130340Z","iopub.execute_input":"2026-05-17T07:22:58.130837Z","iopub.status.idle":"2026-05-17T07:22:58.914286Z","shell.execute_reply.started":"2026-05-17T07:22:58.130799Z","shell.execute_reply":"2026-05-17T07:22:58.913286Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Label(value='Frame: 1920×1080  |  Enter X, Y → Add point  |  Done ✓ saves zone')","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"034984297b224f0f8f3b0213bb42be7b"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"HBox(children=(BoundedIntText(value=960, description='X:', layout=Layout(width='110px'), max=1919, style=Descr…","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"0e8523567e524cfeb04e373ec0255609"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Label(value='No points yet.')","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"0c5bbc8933134df8a5dd334b3dbe91a4"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Image(value=b'', width='100%')","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"b53f00e3320f44b3ab223132098bb18b"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Label(value='Live code output:')","application/vnd.jupyter.w