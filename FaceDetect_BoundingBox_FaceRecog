ize: {len(GUARD_EMBEDDING)} numbers\")\n    print(f\"  First 5 values: {GUARD_EMBEDDING[:5].round(4)}\")\n\n    # ── SHOW THE PHOTO WITH DETECTED FACE BOX ──\n    preview = img.copy()\n    bbox = faces_in_photo[0].bbox.astype(int)\n    cv2.rectangle(preview, (bbox[0], bbox[1]), (bbox[2], bbox[3]), (0, 255, 0), 3)\n    cv2.putText(preview, \"Guard — Enrolled\", (bbox[0], bbox[1]-10),\n                cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)\n    plt.figure(figsize=(6, 6))\n    plt.imshow(cv2.cvtColor(preview, cv2.COLOR_BGR2RGB))\n    plt.title(\"Guard Photo — Face detected ✅\")\n    plt.axis('off')\n    plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-13T09:11:51.014996Z","iopub.execute_input":"2026-05-13T09:11:51.015716Z","iopub.status.idle":"2026-05-13T09:11:53.984561Z","shell.execute_reply.started":"2026-05-13T09:11:51.015682Z","shell.execute_reply":"2026-05-13T09:11:53.983767Z"}},"outputs":[{"name":"stdout","text":"✅ Photo loaded. Size: 180x182 px\nFaces detected in photo: 1\n✅ Perfect — exactly 1 face found!\n\nFace fingerprint (embedding) generated!\n  Size: 512 numbers\n  First 5 values: [    -0.1062      0.0914     -0.0758     -0.0186      0.0484]\n","output_type":"stream"}],"execution_count":42},{"cell_type":"markdown","source":"## CELL 5 — Enter Guard Name + Save to File","metadata":{}},{"cell_type":"code","source":"# Type the guard's name when prompted and press Enter\nGUARD_NAME = input(\"Enter the guard's name: \").strip()\nif GUARD_NAME == \"\":\n    GUARD_NAME = \"Guard_01\"\n    print(\"No name entered. Using: Guard_01\")\n\n# Create the data folder in /kaggle/working/ (only writable folder in Kaggle)\nDATA_FOLDER = \"/kaggle/working/guard_data\"\nos.makedirs(DATA_FOLDER, exist_ok=True)   # exist_ok=True = no error if folder exists\n\n# Save as a dictionary: {name: 512-number array}\n# Dictionary format lets you enroll more guards later if needed\nguard_database = {GUARD_NAME: GUARD_EMBEDDING}\n\nENCODING_FILE = o