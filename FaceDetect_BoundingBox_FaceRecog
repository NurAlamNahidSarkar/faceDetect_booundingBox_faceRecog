tangle(vis, (fx1, fy1), (fx2, fy2), face_col, 2)\n        label = f\"FACE {sim:.2f}\"\n        (lw, lh), _ = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, 0.5, 2)\n        cv2.rectangle(vis, (fx1, fy1 - lh - 8), (fx1 + lw + 6, fy1), face_col, -1)\n        cv2.putText(vis, label, (fx1 + 3, fy1 - 4),\n                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 0), 2)\n\n    # ── Face/body zone indicators ──\n    if state in ('safe', 'alert'):\n        face_str = \"FACE: IN ZONE\" if face_in_zone else (\"FACE: VISIBLE, OUT\" if guard_face_bbox is not None else \"FACE: HIDDEN\")\n        body_str = \"BODY: IN ZONE\" if body_in_zone else \"BODY: OUT OF ZONE\"\n        face_col = (0, 220, 0) if face_in_zone else (180, 180, 0)\n        body_col_txt = (0, 220, 0) if body_in_zone else (0, 0, 220)\n        cv2.putText(vis, face_str, (W - 360, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.58, face_col, 2)\n        cv2.putText(vis, body_str, (W - 360, 58), cv2.FONT_HERSHEY_SIMPLEX, 0.58, body_col_txt, 2)\n\n    # ── Bottom status bar ──\n    cv2.rectangle(vis, (0, H - 50), (W, H), bar_color, -1)\n    cv2.putText(vis, status_txt, (18, H - 14),\n                cv2.FONT_HERSHEY_SIMPLEX, 0.95, (255, 255, 255), 2)\n\n    # Reacquire counter (shown when body temporarily lost)\n    if reacquire_count > 0:\n        cv2.putText(vis, f\"Re-acquiring... ({reacquire_count}/{REACQUIRE_FRAMES})\",\n                    (18, H - 55), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 200, 0), 1)\n\n    return vis\n\n\n# ── STATE ──────────────────────────────────────────────────────────────────────\nguard_locked       = False    # True once guard identity confirmed + body locked\nguard_track_id     = None     # ByteTrack ID of confirmed guard\n\n# Confirmation counters (used in SEARCHING state)\nconfirm_count      = 0        # consecutive frames matching candidate\nconfirm_track_id   = None     # ByteTrack ID being confirmed\n\n# Last-known guard state (only valid when locked)\nlast_body_bbox     = None\nlast_face_bbox     = None\nlast_sim           = 0.0\nlast_body_in_zone  = True\nlast_face_in_zone  = False\nface_visible       = False\n\n# Re-acquisition counter (used when locked but body track lost)\nreacquire_count    = 0\n\n# Alert / stats\n_last_alert_time_local = 0\nframe_idx          = 0\nalert_count        = 0\n\n\n# ── MAIN LOOP ─────────────────────────────────────────────────────────────────\nwhile True:\n    ret, frame = cap.read()\n    if not ret:\n        break\n\n    frame_idx += 1\n\n    # ── Process every Nth frame only ─────────────────────────────────────────\n    if frame_idx % PROCESS_EVERY_N != 0:\n        if last_annotated_frame is not None:\n            writer.write(last_annotated_frame)\n        else:\n            writer.write(frame)\n        continue\n\n    # ── YOLO + ByteTrack (always runs — needed for body tracking) ────────────\n    # persist=True: CRITICAL — keeps track IDs stable across sequential calls\n    track_results = yolo.track(\n        frame,\n        classes=[0],             # person only\n        tracker='bytetrack.yaml',\n        persist=True,\n        verbose=False\n    )[0]\n\n    # Build track_boxes / track_ids lists\n    track_boxes = []\n    track_ids   = []\n    if track_results.boxes.id is not None:\n        for box, tid in zip(track_results.boxes.xyxy, track_results.boxes.id):\n            track_boxes.append(box.cpu().numpy())\n            track_ids.append(int(tid.item()))\n\n    # ── InsightFace (run when needed) ────────────────────────────────────────\n    # Always run if not locked (searching/confirming).\n    # When locked: run to check if face is currently visible.\n    faces = app.get(frame)\n\n    # ═════════════════════════════════════════════════════════════════════════\n    # STATE: NOT LOCKED — search and confirm guard identity\n    # ═════════════════════════════════════════════════════════════════════════\n    if not guard_locked:\n\n        guard_face, best_sim = get_best_face_match(faces)\n\n        if guard_face is not None:\n            candidate_tid = pair_face_to_track(guard_face.bbox, track_boxes, track_ids)\n\n            if candidate_tid is not None:\n                if candidate_tid == confirm_track_id:\n                    confirm_count += 1\n                else:\n                    # New candidate — restart counter\n                    confirm_track_id = candidate_tid\n                    confirm_count    = 1\n\n                if confirm_count >= FACE_CONFIRM_FRAMES:\n                    # ✅ LOCK! Guard identity confirmed.\n                    guard_locked    = True\n                    guard_track_id  = confirm_track_id\n                    confirm_count   = 0\n                    reacquire_count = 0\n\n                    # Find this track's current body bbox\n                    for bbox, tid in zip(track_boxes, track_ids):\n                        if tid == guard_track_id:\n                            last_body_bbox   = np.array(bbox)\n                            last_body_in_zone = pt_in_zone(anchor_pt(last_body_bbox))\n                            break\n\n                    last_face_bbox   = guard_face.bbox\n                    last_face_in_zone = face_pt_in_zone(guard_face.bbox)\n                    last_sim         = best_sim\n                    face_visible     = True\n\n                    print(f\"  ✅ Frame {frame_idx}: LOCKED → track_id={guard_track_id}, \"\n                          f\"sim={best_sim:.2f}, body_in_zone={last_body_in_zone}\")\n            else:\n                # Face matched guard but couldn't pair to any body track\n                # Could be a partial view — don't lock, reset counter\n                confirm_count    = 0\n                confirm_track_id = None\n        else:\n            # No face match at all\n            confirm_count    = 0\n            confirm_track_id = None\n\n        # Draw SEARCHING / CONFIRMING frame\n        state = 'confirming' if confirm_count > 0 else 'searching'\n        annotated = draw_frame(frame, state, None, None, False, False, 0.0)\n\n    # ═════════════════════════════════════════════════════════════════════════\n    # STATE: LOCKED — follow guard's ByteTrack ID\n    # ═════════════════════════════════════════════════════════════════════════\n    else:\n        guard_body_found = False\n\n        # Look for guard's track ID in current frame results\n        for bbox, tid in zip(track_boxes, track_ids):\n            if tid == guard_track_id:\n                guard_body_found  = True\n                reacquire_count   = 0\n                last_body_bbox    = np.array(bbox)\n                last_body_in_zone = pt_in_zone(anchor_pt(last_body_bbox))\n                break\n\n        # ── Face visibility check (every frame when locked) ──────────────────\n        # Even if body is found, check face to determine face_in_zone\n        guard_face, best_sim = get_best_face_match(faces)\n        if guard_face is not None:\n            face_visible      = True\n            last_face_bbox    = guard_face.bbox\n            last_face_in_zone = face_pt_in_zone(guard_face.bbox)\n            last_sim          = best_sim\n        else:\n            face_visible      = False\n            last_face_bbox    = None\n            last_face_in_zone = False\n\n        if guard_body_found:\n            # ── ZONE LOGIC (v4 rules) ─────────────────────────────────────────\n            #\n            # Rule 1: face in zone, body in zone → SAFE\n            # Rule 2: face hidden/out, body in zone → SAFE\n            # Rule 3: face in zone, body outside → OK (SAFE)\n            # Rule 4: face AND body both outside → ALERT\n            # Rule 5: face in zone, body outside → OK (same as rule 3)\n            #\n            # Summary: ALERT only when body_in_zone=False AND face_in_zone=False\n            #\n            if last_body_in_zone:\n                # Rules 1 & 2: body in zone → always SAFE\n                state = 'safe'\n            elif last_face_in_zone:\n                #