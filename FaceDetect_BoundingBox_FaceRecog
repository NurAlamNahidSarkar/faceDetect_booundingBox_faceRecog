")\n\nif len(faces_in_photo) == 0:\n    raise ValueError(\"❌ No face found! Use a clearer, well-lit, front-facing photo.\")\nelif len(faces_in_photo) > 1:\n    print(\"⚠️  Multiple faces found. Using the largest (highest-area) face.\")\n    # Pick by largest bbox area — most likely the intended subject\n    faces_in_photo.sort(key=lambda f: (f.bbox[2]-f.bbox[0])*(f.bbox[3]-f.bbox[1]), reverse=True)\nelse:\n    print(\"✅ Exactly 1 face found.\")\n\nGUARD_EMBEDDING = faces_in_photo[0].normed_embedding\nprint(f\"\\nFace embedding generated! Size: {len(GUARD_EMBEDDING)} numbers\")\nprint(f\"First 5 values: {GUARD_EMBEDDING[:5].round(4)}\")\n\n# Show preview\npreview = img.copy()\nbbox = faces_in_photo[0].bbox.astype(int)\ncv2.rectangle(preview, (bbox[0], bbox[1]), (bbox[2], bbox[3]), (0, 255, 0), 3)\ncv2.putText(preview, \"Guard — Enrolled\", (bbox[0], bbox[1]-10),\n            cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)\n\nimport io, ipywidgets as widgets\nfrom IPython.display import display\nbuf = io.BytesIO()\nfig, ax = plt.subplots(figsize=(6, 6))\nax.imshow(cv2.cvtColor(preview, cv2.COLOR_BGR2RGB))\nax.set_title(\"Guard Photo — Face detected ✅\")\nax.axis('off')\nfig.savefig(buf, format='png', bbox_inches='tight')\nplt.close(fig)\nbuf.seek(0)\ndisplay(widgets.Image(value=buf.read(), format='png', width='400px'))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-13T11:45:55.084982Z","iopub.execute_input":"2026-05-13T11:45:55.085372Z","iopub.status.idle":"2026-05-13T11:45:55.330334Z","shell.execute_reply.started":"2026-05-13T11:45:55.085334Z","shell.execute_reply":"2026-05-13T11:45:55.329687Z"}},"outputs":[{"name":"stdout","text":"✅ Photo loaded. Size: 180x182 px\nFaces detected in photo: 1\n✅ Exactly 1 face found.\n\nFace embedding generated! Size: 512 numbers\nFirst 5 values: [    -0.1062      0.0914     -0.0758     -0.0186      0.0484]\n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_57/2402138072.py:40: UserWarning: Glyph 