list)}: ({x_box.value},{y_box.value})  | Total: {len(zone_points_list)}\"\n    refresh_code(); draw_canvas()\ndef on_undo(_):\n    if zone_points_list:\n        removed = zone_points_list.pop()\n        status_lbl.value = f\"Removed {removed}  |  {len(zone_points_list)} left\"\n        refresh_code(); draw_canvas()\ndef on_reset(_):\n    zone_points_list.clear()\n    status_lbl.value = 'Reset.'\n    refresh_code(); draw_canvas()\ndef on_done(_):\n    if len(zone_points_list) < 3:\n        status_lbl.value = '⚠ Need at least 3 points.'\n        return\n    global zone_points\n    zone_points = np.array(zone_points_list, dtype=np.int32)\n    zone_data = {'zone_points': zone_points.tolist(), 'frame_width': FRAME_W, 'frame_height': FRAME_H}\n    os.makedirs(DATA_FOLDER, exist_ok=True)\n    with open(ZONE_FILE, 'w') as f:\n        json.dump(zone_data, f, indent=4)\n    status_lbl.value = f\"✅ Done! {len(zone_points_list)} corners saved → {ZONE_FILE}\"\n    draw_canvas()\n    print(f\"\\n✅ PHASE 2 COMPLETE — zone saved to {ZONE_FILE}\")\n    print(f\"zone_points =\\n{zone_points}\")\n\nbtn_add.on_click(on_add); btn_undo.on_click(on_undo)\nbtn_reset.on_click(on_reset); btn_done.on_click(on_done)\ncontrols = widgets.HBox([x_box, y_box, btn_add, btn_undo, btn_reset, btn_done],\n                         layout=widgets.Layout(gap='8px', align_items='center'))\ndisplay(widgets.Label(value=f'Frame: {FRAME_W}×{FRAME_H}  |  Enter X, Y → Add point  |  Done ✓ saves zone'),\n        controls, status_lbl, img_widget,\n        widgets.Label(value='Live code output:'), code_lbl)\ndraw_canvas()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-13T12:08:18.013729Z","iopub.execute_input":"2026-05-13T12:08:18.014451Z","iopub.status.idle":"2026-05-13T12:08:18.800639Z","shell.execute_reply.started":"2026-05-13T12:08:18.014415Z","shell.execute_reply":"2026-05-13T12:08:18.799586Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Label(value='Frame: 1920×1080 