zone_data[\"frame_width\"]\nFRAME_H  = zone_data[\"frame_height\"]\nprint(f\"Loaded zone: {len(zone_pts)} corners, frame {FRAME_W}x{FRAME_H}\")\nprint(\"✅ All data loaded!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T07:23:38.324709Z","iopub.execute_input":"2026-05-17T07:23:38.325134Z","iopub.status.idle":"2026-05-17T07:23:38.332506Z","shell.execute_reply.started":"2026-05-17T07:23:38.325102Z","shell.execute_reply":"2026-05-17T07:23:38.331776Z"}},"outputs":[{"name":"stdout","text":"Loaded 1 guard(s): ['MAMA']\nLoaded zone: 4 corners, frame 1920x1080\n✅ All data loaded!\n","output_type":"stream"}],"execution_count":9},{"cell_type":"markdown","source":"## CELL 10 — Helper Functions","metadata":{}},{"cell_type":"code","source":"# ── SIMILARITY THRESHOLD ──────────────────────────────────────────────────────\n# buffalo_l ArcFace: 0.45 is a safe floor. Raise to 0.55 if strangers match.\nSIMILARITY_THRESHOLD = 0.45\n\n\ndef best_face_match(faces):\n    \"\"\"\n    Compare all detected faces against enrolled guard embedding.\n    Returns (face_obj, similarity) if any face >= SIMILARITY_THRESHOLD,\n    else (None, best_sim_found).\n    Only ONE guard is enrolled so we pick the single best match.\n    \"\"\"\n    best_face, best_sim = None, 0.0\n    for face in faces:\n        sim = 1.0 - cosine(GUARD_EMBEDDING, face.normed_embedding)\n        if sim > best_sim:\n            best_sim = sim\n            best_face = face\n    if best_face is not None and best_sim >= SIMILARITY_THRESHOLD:\n        return best_face, best_sim\n    return None, best_sim\n\n\ndef face_owns_body(face_bbox, body_bbox):\n    \"\"\"\n    Returns True if the face center falls within the TOP 45% of the body box.\n    This is stricter than v3's 40% (better at crowded scenes).\n    Also checks horizontal containment.\n    \"\"\"\n    fx1, fy1, fx2, fy2 = face_bbox.astype(int)\n    bx1, by1, bx2, by2 = body_bbox.astype(int)\n    face_cx = (fx1 + fx2) // 2\n    face_cy = (fy1 + fy2) // 2\n    head_bottom = by1 + int((by2 - by1) * 0.45)\n    return (bx1 <= face_cx <= bx2) and (by1 <= face_cy <= head_bottom)\n\n\ndef find_guard_track_id(guard_face_bbox, track_boxes, track_ids):\n    \"\"\"\n    Given a matched face bbox, find which ByteTrack ID 'owns' it.\n    Among candidates where face_owns_body() passes, pick the one\n    with the smallest body box (closest = most likely the guard, not\n    a large person behind them).\n    Returns track_id (int) or None.\n    \"\"\"\n    best_id   = None\n    best_area = float('inf')\n    for bbox, tid in zip(track_boxes, track_ids):\n        if face_owns_body(guard_face_bbox, bbox):\n            area = (bbox[2] - bbox[0]) * (bbox[3] - bbox[1])\n            if area < best_area:\n                best_area = area\n                best_id   = tid\n    return best_id\n\n\ndef anchor_pt(bbox):\n    \"\"\"Shoulder-center of body bbox (top 25%).\"\"\"\n    x1, y1, x2, y2 = bbox.astype(int)\n    return ((x1 + x2) // 2, y1 + int((y2 - y1) * 0.25))\n\n\ndef in_zone(pt, polygon):\n    \"\"\"True if pixel point is inside the guard zone polygon.\"\"\"\n    return cv2.pointPolygonTest(\n        polygon.reshape(-1, 1, 2),\n        (float(pt[0]), float(pt[1])), False\n    ) >= 0\n\n\ndef face_center(bbox):\n    x1, y1, x2, y2 = bbox.astype(int)\n    return ((x1 + x2) // 2, (y1 + y2) // 2)\n\n\nprint(\"✅ Helper functions ready.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T07:23:40.496335Z","iopub.execute_input":"2026-05-17T07:23:40.496969Z","iopub.status.idle":"2026-05-17T07:23:40.507500Z","shell.execute_reply.started":"2026-05-17T07:23:40.496932Z","shell.execute_reply":"2026-05-17T07:23:40.506875Z"}},"outputs":[{"name":"stdout","text":"✅ Helper functions ready.\n","output_type":"stream"}],"execution_count":10},{"cell_type":"markdown","source":"## CELL 11 — Alert System","metadata":{}},{"cell_type":"code","source":"ALERT_LOG_FILE      = os.path.join(\"/kaggle/working\", \"alert_log.txt\")\nALERT_COOLDOWN_SEC  = 3   # minimum seconds between logged alerts (prevents log spam)\n_last_alert_time_local = 0\n\n\ndef log_alert_local(reason):\n    global _last_alert_time_local\n    now = time.time()\n    if now - _last_alert_time_local < ALERT_COOLDOWN_SEC:\n        return\n    _last_alert_time_local = now\n    ts  = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n\n    # Calculate video timestamp from frame index\n    video_seconds = frame_idx / fps\n    video_minutes = int(video_seconds // 60)\n    video_secs    = int(video_seconds % 60)\n    video_ts      = f\"{video_minutes:02d}:{video_secs:02d}\"\n\n    msg = f\"[{ts}] 🚨 ALERT — {reason} | VIDEO TIME: {video_ts}\"\n    print(msg)\n    with open(ALERT_LOG_FILE, 'a') as f:\n        f.write(msg + '\\n')\n\n\nprint(f\"✅ Alert system ready. Log: {ALERT_LOG_FILE}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-17T07:23:43.345494Z","iopub.execute_input":"2026-05-17T07:23:43.346162Z","iopub.status.idle":"2026-05-17T07:23:43.351962Z","shell.execute_reply.started":"2026-05-17T07:23:43.346129Z","shell.execute_reply":"2026-05-17T07:23:43.351296Z"}},"outputs":[{"name":"stdout","text":"✅ Alert system ready. Log: /kaggle/working/alert_log.txt\n","output_type":"stream"}],"execution_count":11},{"cell_type":"markdown","source":"---\n# 🔴 PHASE 4 — CONTINUOUS DETECTION LOOP\n\n**This is the main loop.** For every frame of the video:\n1. `app.get(frame)` → finds all faces (InsightFace)\n2. `recognize_guard()` → checks if any face matches the enrolled guard photo\n3. `is_inside_zone()` → checks if the guard's face center is inside the polygon\n4. `draw_frame()` → draws zone + status on the frame\n5. `check_and_alert()` → logs alert if guard is missing or outside zone\n\n---\n## CELL 12 — Run the Detection Loop","metadata":{}},{"cell_type":"code","source":"start_time = time.time()\n## ╔═══════════════════════════════════════════════════════════════════════╗\n## ║  CELL 12 — v4 COMPLETE REWRITE                                         ║\n## ║  Fixes: false lock, stale SAFE on exit, ghost bbox, other-person lock  ║\n## ║  Model: YOLOv8l + ByteTrack                                            ║\n## ╚═══════════════════════════════════════════════════════════════════════╝\n\n# ── CONFIG ────────────────────────────────────────────────────────────────────\nOUTPUT_VIDEO         = '/kaggle/working/output_monitored.mp4'\nALERT_LOG_FILE       = '/kaggle/working/alert_log.txt'\nPROCESS_EVERY_N      = 15           # skip every other frame for speed\nSIMILARITY_THRESHOLD = 0.45        # ArcFace cosine similarity floor\nALERT_COOLDOWN_SEC   = 3           # min seconds between logged alerts\nlast_annotated_frame = None\nRE_LOCK_THRESHOLD = 0.60\n\n# How many consecutive frames the same ByteTrack ID must match the guard face\n# before we \"lock\" onto it. Prevents single-frame false locks.\n# 5 frames * PROCESS_EVERY_N=2 = 10 real frames = 0.33s at 30fps\nFACE_CONFIRM_FRAMES  = 2\n\n# After guard's ByteTrack ID vanishes, how many processed frames to attempt\n# face re-ID before giving up and going back to SEARCHING.\n# During these frames we STILL ALERT (guard not detected).\n# This gives ByteTrack a chance to recover from a 1-2 frame detection miss.\n# Set to 8 (= ~0.5s). Beyond this, body is truly gone → back to SEARCHING.\nREACQUIRE_FRAMES     = 3\n\n# ── MODELS ────────────────────────────────────────────────────────────────────\n# InsightFace buffalo_l: SCRFD detection + ArcFace recognition\napp = FaceAnalysis(\n    name='buffalo_l',\n    providers=['CUDAExecutionProvider', 'CPUExecutionProvider']\n)\napp.prepare(ctx_id=0, det_size=(640, 640))\n\n# YOLOv8l — large model, best recall for partially-visible persons on T4 GPU\n# ByteTrack activated via tracker= argument + persist=True\nyolo = YOLO('yolov8n.pt')\n\n\n\n# ── VIDEO SETUP ───────────────────────────────────────────────────────────────\ncap          = cv2.VideoCapture(VIDEO_PATH)\nfps          = cap.get(cv2.CAP_PROP_FPS)\ntotal_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\nW = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\nH = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\nfourcc = cv2.VideoWriter_fourcc(*'mp4v')\nwriter = cv2.VideoWriter(OUTPUT_VIDEO, fourcc, fps, (W, H))\n\nos.makedirs('/kaggle/working', exist_ok=True)\nopen(ALERT_LOG_FILE, 'w').close()   # clear old log\n\nprint(f\"Video      : {W}x{H} @ {fps:.0f} fps | {total_frames} frames\")\nprint(f\"Model      : YOLOv8l + ByteTrack\")\nprint(f\"Threshold  : {SIMILARITY_THRESHOLD}\")\nprint(f\"Confirm    : {FACE_CONFIRM_FRAMES} consecutive frames before lock\")\nprint(f\"Reacquire  : {REACQUIRE_FRAMES} frames before giving up re-ID\")\nprint(f\"Zone pts   : {len(zone_pts)}\")\nprint()\n\n\n# ── PURE HELPER FUNCTIONS ─────────────────────────────────────────────────────\n\ndef log_alert_local(reason):\n    global _last_alert_time_local\n    now = time.time()\n    if now - _last_alert_time_local < ALERT_COOLDOWN_SEC:\n        return\n    _last_alert_time_local = now\n    ts  = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n    msg = f\"[{ts}] 🚨 ALERT — {reason}\"\n    print(msg)\n    with open(ALERT_LOG_FILE, 'a') as f:\n        f.write(msg + '\\n')\n\n\ndef get_best_face_match(faces):\n    \"\"\"Returns (face, sim) of the best match >= threshold, else (None, sim).\"\"\"\n    best_face, best_sim = None, 0.0\n    for face in faces:\n        sim = 1.0 - cosine(GUARD_EMBEDDING, face.normed_embedding)\n        if sim > best_sim:\n            best_sim, best_face = sim, face\n    if best_face is not None and best_sim >= SIMILARITY_THRESHOLD:\n        return best_face, best_sim\n    return None, best_sim\n\n\ndef pair_face_to_track(face_bbox, track_boxes, track_ids):\n    \"\"\"\n    Find which ByteTrack ID the face belongs to.\n    Face center must be within top 45% of the body box (head region).\n    If multiple candidates, pick smallest area body box.\n    \"\"\"\n    fx1, fy1, fx2, fy2 = face_bbox.astype(int)\n    fcx = (fx1 + fx2) // 2\n    fcy = (fy1 + fy2) // 2\n    best_id, best_area = None, float('inf')\n    for bbox, tid in zip(track_boxes, track_ids):\n        bx1, by1, bx2, by2 = bbox.astype(int)\n        head_bottom = by1 + int((by2 - by1) * 0.45)\n        if bx1 <= fcx <= bx2 and by1 <= fcy <= head_bottom:\n            area = (bx2 - bx1) * (by2 - by1)\n            if area < best_area:\n                best_area, best_id = area, tid\n    return best_id\n\n\ndef anchor_pt(bbox):\n    \"\"\"Shoulder-center of body bbox (top 25%).\"\"\"\n    x1, y1, x2, y2 = bbox.astype(int)\n    return ((x1 + x2) // 2, y1 + int((y2 - y1) * 0.25))\n\n\ndef pt_in_zone(pt):\n    return cv2.pointPolygonTest(\n        zone_pts.reshape(-1, 1, 2),\n        (float(pt[0]), float(pt[1])), False\n    ) >= 0\n\n\ndef face_pt_in_zone(face_bbox):\n    \"\"\"True if face bounding box center is inside the zone.\"\"\"\n    fx1, fy1, fx2, fy2 = face_bbox.astype(int)\n    return pt_in_zone(((fx1+fx2)//2, (fy1+fy2)//2))\n\n\ndef draw_frame(frame, state, guard_body_bbox, guard_face_bbox,\n               body_in_zone, face_in_zone, sim, reacquire_count=0):\n    \"\"\"\n    Draws zone polygon + status bar + body/face boxes.\n    ONLY guard's bboxes are drawn — no other persons.\n\n    state: 'searching' | 'confirming' | 'safe' | 'alert'\n    \"\"\"\n    vis = frame.copy()\n\n    # ── Determine display colors ──\n    if state == 'safe':\n        zone_color = (0, 200, 0)\n        bar_color  = (0, 130, 0)\n        status_txt = f\"✅ GUARD IN ZONE — SAFE\"\n    elif state == 'alert':\n        zone_color = (0, 0, 220)\n        bar_color  = (0, 0, 180)\n        status_txt = \"🚨 ALERT: GUARD NOT IN ZONE!\"\n    elif state == 'confirming':\n        zone_color = (0, 200, 200)\n        bar_color  = (50, 50, 50)\n        status_txt = f\"Confirming guard identity...\"\n    else:  # searching\n        zone_color = (80, 80, 80)\n        bar_color  = (50, 50, 50)\n        status_txt = \"Searching for guard...\"\n\n    # ── Zone 